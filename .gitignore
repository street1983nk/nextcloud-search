# Key material and secrets. The app certificate is bound to the app id, and a leaked
# private key means a revoke and replace round in nextcloud/app-certificate-requests.
*.key
*.pem
*.crt
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/

# PHP
vendor/
# Result cache of the PHPUnit suite, written next to php/phpunit.xml. It is a
# per machine artefact of the last run and says nothing a checkout needs.
.phpunit.cache/

# Runtime and build output
data/
# Local development state written by scripts/dev/register-exapp.sh: backend log,
# process id and the persistent storage of the locally started ExApp.
.dev/
*.tar.gz
dist/
build/

# Agent scratch state, must never reach the public repository
.claude-active
.claude/worktrees/

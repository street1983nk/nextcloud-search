{
	"_comment": [
		"The shared catalogue of the share identity (plan 43-21, D-43-15, D-43-17, owner decisions OE-1 a, OE-2 a, OE-3 a, OE-4 a in 43-FREIGABEN.md).",
		"A storage id of the smb or sftp backend gives one identity {share, root}: share is backend, host (ASCII lower case) and for SMB the share name (ASCII lower case), for SFTP the login name (as written) in front of the host; root is the root without leading and trailing slashes, unfolded, in Unicode NFC like the Nextcloud file cache. Null means never grouped, the counting of 1.5.",
		"cases: an id out of oc_storages.id and the identity typed by hand. hashed: ids above 64 characters that Nextcloud stores as md5 (Storage.php adjustStorageId); actual is the id Nextcloud wrote, stored = md5(actual) computed with the command in derivation, reconstructed is what the companion rebuilds from oc_external_config and the user id of the mount (null when a placeholder other than $user is left), and only reconstructed == actual gives an identity.",
		"groups: the mbozem situation of #25 with invented login names, and the expected counting groups. stats: the five counters when every case and every hashed entry is asked in one call.",
		"Nothing here was computed with the code under test. php/tests/Unit/StorageServiceTest.php reads this file, backend/tests/test_share_identity_cases.py recomputes every md5 with hashlib."
	],
	"decisions": {
		"OE-1": "a",
		"OE-2": "a",
		"OE-3": "a",
		"OE-4": "a"
	},
	"cases": [
		{
			"id": "smb::a@192.168.98.246//Daten//",
			"expected": {
				"share": "smb::192.168.98.246//daten",
				"root": ""
			},
			"why": "root / as SMB.php writes it, share name folded",
			"decision": "OE-1"
		},
		{
			"id": "smb::b@192.168.98.246//daten//",
			"expected": {
				"share": "smb::192.168.98.246//daten",
				"root": ""
			},
			"why": "the same share in lower case is the same share (Samba section names ignore case)",
			"decision": "OE-1"
		},
		{
			"id": "smb::c@192.168.98.246//Daten//Projekte/",
			"expected": {
				"share": "smb::192.168.98.246//daten",
				"root": "Projekte"
			},
			"why": "a sub root of the same share is the same share with its own root",
			"decision": "OE-1"
		},
		{
			"id": "smb::d@192.168.98.246//DATEN//Arbeitssicherheit/",
			"expected": {
				"share": "smb::192.168.98.246//daten",
				"root": "Arbeitssicherheit"
			},
			"why": "share name in capitals folds, the root keeps its spelling",
			"decision": "OE-1"
		},
		{
			"id": "smb::a@FileServer.local//Daten//",
			"expected": {
				"share": "smb::fileserver.local//daten",
				"root": ""
			},
			"why": "host names ignore case (RFC 4343)",
			"decision": "OE-1"
		},
		{
			"id": "smb::b@fileserver.local//Daten//",
			"expected": {
				"share": "smb::fileserver.local//daten",
				"root": ""
			},
			"why": "same host in lower case, same share"
		},
		{
			"id": "smb::a@192.168.98.2//Daten//",
			"expected": {
				"share": "smb::192.168.98.2//daten",
				"root": ""
			},
			"why": "another host is another share"
		},
		{
			"id": "smb::a@fs.example//Daten//Projekte/",
			"expected": {
				"share": "smb::fs.example//daten",
				"root": "Projekte"
			},
			"why": "root keeps its capital",
			"decision": "OE-1"
		},
		{
			"id": "smb::a@fs.example//Daten//projekte/",
			"expected": {
				"share": "smb::fs.example//daten",
				"root": "projekte"
			},
			"why": "a root that differs only in case is another root (two folders on a Linux server)",
			"decision": "OE-1"
		},
		{
			"id": "smb::a@fs.example//Daten//Gr\u00fc\u00dfe/",
			"expected": {
				"share": "smb::fs.example//daten",
				"root": "Gr\u00fc\u00dfe"
			},
			"why": "a composed umlaut stays as it is"
		},
		{
			"id": "smb::b@fs.example//Daten//Gru\u0308\u00dfe/",
			"expected": {
				"share": "smb::fs.example//daten",
				"root": "Gr\u00fc\u00dfe"
			},
			"why": "a decomposed umlaut in the root becomes NFC, the form of the Nextcloud file cache (Cache.php normalize)"
		},
		{
			"id": "smb::a@fs.example//Daten//a//b/",
			"expected": {
				"share": "smb::fs.example//daten",
				"root": "a/b"
			},
			"why": "doubled slashes inside the root collapse"
		},
		{
			"id": "smb::a@fs.example//Daten//./a/",
			"expected": {
				"share": "smb::fs.example//daten",
				"root": "a"
			},
			"why": "a '.' segment is dropped"
		},
		{
			"id": "smb::a@fs.example//Daten//./",
			"expected": {
				"share": "smb::fs.example//daten",
				"root": ""
			},
			"why": "a root of only '.' is the share root"
		},
		{
			"id": "smb::a@fs.example//Daten//a/../b/",
			"expected": null,
			"why": "a '..' segment could leave the tree, never grouped"
		},
		{
			"id": "smb::a@fs.example//Daten//a\\b/",
			"expected": null,
			"why": "a backslash in the root is a separator on the server, never grouped"
		},
		{
			"id": "home::alice",
			"expected": null,
			"why": "home storage, not an external share"
		},
		{
			"id": "local::/srv/",
			"expected": null,
			"why": "local storage, not in the backend list"
		},
		{
			"id": "0123456789abcdef0123456789abcdef",
			"expected": null,
			"why": "a hashed id says nothing by itself, only the configuration with a matching md5 can"
		},
		{
			"id": "webdav::anna@dav.example/remote.php/webdav//",
			"expected": null,
			"why": "WebDAV is not in the backend list"
		},
		{
			"id": "owncloud::anna@cloud.example//",
			"expected": null,
			"why": "ownCloud is not in the backend list"
		},
		{
			"id": "smb::host//Daten//",
			"expected": null,
			"why": "no '@' in front of the first '//'"
		},
		{
			"id": "smb::a@//Daten//",
			"expected": null,
			"why": "empty host"
		},
		{
			"id": "smb::a@fs.example////",
			"expected": null,
			"why": "empty share name"
		},
		{
			"id": "smb::a@fs.example//Daten/",
			"expected": null,
			"why": "no '//' between share and root, not the form of SMB.php getId"
		},
		{
			"id": "smb::a@fs.example//Daten/Sub//",
			"expected": null,
			"why": "share name with '/'"
		},
		{
			"id": "smb::a@fs.example//Daten\\Sub//",
			"expected": null,
			"why": "share name with a backslash"
		},
		{
			"id": "smb::corp//anna@fs.example//team//",
			"expected": null,
			"why": "the first '//' ends the host part, so there is no '@' in front of it"
		},
		{
			"id": "",
			"expected": null,
			"why": "empty id"
		},
		{
			"id": "smb::alice@fs.example//homes//",
			"expected": null,
			"why": "[homes] gives every user an own tree under one name",
			"decision": "OE-3"
		},
		{
			"id": "smb::alice@fs.example//HOMES//x/",
			"expected": null,
			"why": "[homes] in capitals",
			"decision": "OE-3"
		},
		{
			"id": "smb::alice@fs.example//Alice//",
			"expected": null,
			"why": "a share equal to the login name is a home share",
			"decision": "OE-3"
		},
		{
			"id": "smb::max@firma.de@192.168.98.246//Daten//",
			"expected": {
				"share": "smb::192.168.98.246//daten",
				"root": ""
			},
			"why": "the host is the text after the LAST '@'"
		},
		{
			"id": "sftp::a@Host.example//",
			"expected": {
				"share": "sftp::a@host.example",
				"root": ""
			},
			"why": "SFTP share is login plus host, host folded",
			"decision": "OE-4"
		},
		{
			"id": "sftp::a@host.example//srv/data/",
			"expected": {
				"share": "sftp::a@host.example",
				"root": "srv/data"
			},
			"why": "same login, another root, same share",
			"decision": "OE-4"
		},
		{
			"id": "sftp::b@host.example//",
			"expected": {
				"share": "sftp::b@host.example",
				"root": ""
			},
			"why": "another login is another share (chroot per user never merges)",
			"decision": "OE-4"
		},
		{
			"id": "sftp::Anna@host.example//",
			"expected": {
				"share": "sftp::Anna@host.example",
				"root": ""
			},
			"why": "the login name is not folded",
			"decision": "OE-4"
		},
		{
			"id": "sftp::a@host.example:2222//",
			"expected": {
				"share": "sftp::a@host.example:2222",
				"root": ""
			},
			"why": "the port stays in the share",
			"decision": "OE-4"
		},
		{
			"id": "sftp::anna@corp.example@Host.example//data/",
			"expected": {
				"share": "sftp::anna@corp.example@host.example",
				"root": "data"
			},
			"why": "a login with '@' stays whole, only the host is folded",
			"decision": "OE-4"
		}
	],
